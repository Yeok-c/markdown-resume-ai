# Environment Configuration

# DeepInfra Configuration (OpenAI-compatible API) - Recommended
# Get your key from: https://deepinfra.com/
DEEPINFRA_API_KEY=your_deepinfra_api_key_here
# LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
# Other models: google/gemini-2.5-flash, microsoft/Phi-4, mistralai/Mixtral-8x7B-Instruct-v0.1

# OR use OpenAI (alternative)
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4-turbo-preview
# LLM_MODEL=gpt-4
# LLM_MODEL=gpt-3.5-turbo

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for Chrome extension redirect)
FRONTEND_URL=http://localhost:3000

# Resources Path
RESOURCES_PATH=../resources
